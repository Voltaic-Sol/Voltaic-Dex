# Example environment variables for local development and deployment
# Copy this file to .env and fill in real values. DO NOT commit .env with secrets.

# Anchor / Solana provider settings
ANCHOR_PROVIDER_URL=http://127.0.0.1:8899    # localnet RPC URL or https://api.devnet.solana.com
ANCHOR_WALLET=~/.config/solana/id.json        # path to your Solana keypair (wallet)

# Program / deployment
DEX_PROGRAM_ID=ReplaceWithYourProgramID      # program ID output after deploy
POOL_STATE_FILE=pool_state.json              # optional path to pool state file used by scripts

# Node / NPM
NODE_ENV=development

# Optional: any other secrets or keys should be placed in your local .env and excluded from git
# For example: API_KEY=your_api_key_here
